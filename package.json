{
  "name": "@mborne/markdown-to-html",
  "version": "0.11.0",
  "description": "Experimental static site renderer/server supporting markdown and HTML/JS views",
  "main": "index.js",
  "type": "module",
  "bin": {
    "markdown-to-html": "bin/main.js"
  },
  "keywords": [
    "markdown",
    "marked",
    "site-generator",
    "express",
    "server"
  ],
  "scripts": {
    "start": "node bin/main.js serve -l default samples/01-default-layout",
    "build-demo": "npm run build-demo-01 && npm run build-demo-02",
    "build-demo-01": "node bin/main.js convert -l default samples/01-default-layout demo/01-default-layout --force",
    "build-demo-02": "node bin/main.js convert -l remarkjs samples/02-remarkjs demo/02-remarkjs --force",
    "test": "jest",
    "coverage": "jest --coverage",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "check-style": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "fix-style": "prettier --write \"src/**/*.js\" \"test/**/*.ts\""
  },
  "author": "Mickael Borne <mborne@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mborne/markdown-to-html.git"
  },
  "license": "MIT",
  "dependencies": {
    "@types/node": "^22.10.1",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "front-matter": "^4.0.2",
    "handlebars": "^4.7.8",
    "marked": "^15.0.3",
    "morgan": "^1.10.0",
    "shelljs": "^0.8.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "coveralls": "^3.1.1",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "uuid": "^11.0.3"
  }
}
